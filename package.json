{
  "name": "hotel-search",
  "version": "1.0.0",
  "description": "Al-Rais hotel search BFF (Provesio + GIATA enrichment on detail)",
  "type": "module",
  "private": true,
  "scripts": {
    "deploy:dev": "serverless deploy --config serverless-dev.yml --stage dev",
    "deploy:qa": "serverless deploy --config serverless-qa.yml --stage qa",
    "deploy:prod": "serverless deploy --config serverless-prod.yml --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "axios": "^1.7.9",
    "ioredis": "^5.4.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "serverless": "^3.39.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-prune-plugin": "^2.1.0",
    "serverless-ssm-fetch": "^2.0.0"
  }
}
